  "iteration_scopes": {
    "scopes": [
      {
        "id": "major",
        "name": "Iteración mayor",
        "description": "Nueva versión que altera arquitectura, alcance o cohorte de stakeholders.\nCascada completa porque cualquier fase puede aportar insight crítico.\n",
        "keywords": [
          "v3",
          "v4",
          "rewrite",
          "redesign",
          "evolución mayor",
          "rearquitectura",
          "nueva versión mayor"
        ],
        "skip_phases": [],
        "minimal_phases": {},
        "full_phases": [
          "discovery",
          "inception",
          "functional-analysis",
          "technical-design",
          "construction",
          "qa-testing",
          "uat",
          "deployment",
          "stabilization",
          "closure"
        ],
        "default_layout_strategy": "C"
      },
      {
        "id": "minor",
        "name": "Iteración menor (mejoras)",
        "description": "Mejoras incrementales sobre versión cerrada. NO requiere repetir\nDiscovery (ya hubo) ni Inicio (acta+kickoff vigentes). Análisis\nsólo para los items afectados. Diseño sólo para componentes nuevos.\nConstrucción + QA + UAT + Deploy completos para el delta.\n",
        "keywords": [
          "mejoras",
          "mejora",
          "v2.1",
          "v2.2",
          "v3.1",
          "incremental",
          "evolución",
          "siguiente iteración",
          "refinamiento"
        ],
        "skip_phases": [
          "discovery",
          "inception"
        ],
        "minimal_phases": {
