            "technical-task-breakdown"
          ]
        },
        "full_phases": [
          "construction",
          "qa-testing",
          "uat",
          "deployment"
        ],
        "default_layout_strategy": "A"
      },
      {
        "id": "patch",
        "name": "Patch / corrección",
        "description": "Corrección de defecto sobre versión cerrada. Sin cambio de scope.\nSalta Discovery, Inicio, Análisis funcional y Diseño. Construcción\nenfocada al fix + QA de regresión + Deploy.\n",
        "keywords": [
          "patch",
          "fix",
          "corrección",
          "bug fix",
          "v2.0.1",
          "v2.0.x",
          "hotpatch"
        ],
        "skip_phases": [
          "discovery",
